<div style="text-align: center;">
<span style="font-family: monospace; display: inline-block; text-align: left;">
💩 {% set waste = states('sensor.litter_robot_5_waste_drawer') | float(0) %}
{% if waste >= 70 %}
<font color="#F44336"><b>{{ '%3d' | format(waste) }}%</b></font> ⚠️
{% elif waste >= 40 %}
<font color="#FF9800"><b>{{ '%3d' | format(waste) }}%</b></font>
{% else %}
<font color="#4CAF50"><b>{{ '%3d' | format(waste) }}%</b></font>
{% endif %}
<br>

🏖️ {% set litter = states('sensor.litter_robot_5_litter_level') | float(0) %}
{% if litter >= 70 %}
<font color="#4CAF50"><b>{{ '%3d' | format(litter) }}%</b></font>
{% elif litter >= 40 %}
<font color="#FF9800"><b>{{ '%3d' | format(litter) }}%</b></font>
{% else %}
<font color="#F44336"><b>{{ '%3d' | format(litter) }}%</b></font> ⚠️
{% endif %}
<br>

💧 {% set water = states('sensor.dockstream_smart_fountain_remaining_water_2') | float(0) %}
{% if water >= 70 %}
<font color="#4CAF50"><b>{{ '%3d' | format(water) }}%</b></font>
{% elif water >= 20 %}
<font color="#FF9800"><b>{{ '%3d' | format(water) }}%</b></font>
{% else %}
<font color="#F44336"><b>{{ '%3d' | format(water) }}%</b></font> ⚠️
{% endif %}
<br>

🍽️ {% set food = states('binary_sensor.granary_smart_feeder_1_food_status') %}
{% if food == 'OK' %}
<font color="#4CAF50"><b>{{ food }}</b></font>
{% else %}
<font color="#F44336"><b>{{ food }}</b></font> ⚠️
{% endif %}
</span>
</div>
